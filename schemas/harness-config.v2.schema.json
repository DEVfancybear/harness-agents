  "$id": "https://harness-agents.local/schemas/harness-config.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Additive user configuration contract for the interactive agent.\n\nThe v1 [`HarnessConfig`] remains frozen for P0 consumers and keeps generating\n`harness-config.v1.schema.json`; this v2 contract is emitted separately.",
  "properties": {
    "cli": {
      "$ref": "#/$defs/CliPresentationConfig",
      "default": {
        "output": "text"
      }
    },
    "hooks": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/HookConfigV2"
        },
        "type": "array"
      },
      "default": {},
      "type": "object"
    },
    "limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/LimitsConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mcp_servers": {
      "additionalProperties": {
        "$ref": "#/$defs/McpServerConfigV2"
      },
      "default": {},
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelConfigV2"
      },
      "default": {},
      "type": "object"
    },
    "permissions": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionsConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ProfileConfigV2"
      },
      "default": {},
      "type": "object"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 2,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "trust": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrustConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "HarnessConfigV2",
  "type": "object",
  "x-harness-schema-version": 2
}
