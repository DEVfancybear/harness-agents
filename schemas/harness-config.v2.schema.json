{
  "$defs": {
    "AgentsConfigV2": {
      "additionalProperties": false,
      "properties": {
        "default_model": {
          "default": null,
          "description": "The model a child runs on when it does not ask for one, as `provider/id`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CliOutputFormat": {
      "enum": [
        "text",
        "json"
      ],
      "type": "string"
    },
    "CliPresentationConfig": {
      "additionalProperties": false,
      "properties": {
        "output": {
          "$ref": "#/$defs/CliOutputFormat",
          "default": "text"
        }
      },
      "type": "object"
    },
    "HookConfigV2": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "matcher": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_seconds": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "LimitsConfigV2": {
      "additionalProperties": false,
      "properties": {
        "compaction_reserve_tokens": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "continuations": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "deadline_seconds": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_retry_after_seconds": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_steps": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tool_calls": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_reservation_tokens": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "McpServerConfigV2": {
      "additionalProperties": false,
      "description": "One configured MCP server. Stdio is the default transport; a remote\nStreamable HTTP endpoint may instead name an environment variable holding\nits bearer token. Secret values are never stored in configuration.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bearer_token_env": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "disabled_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": null,
          "description": "prime-agent's `enabled`: `false` keeps the server configured but does\nnot start it. Omitted means enabled.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "enabled_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "header_env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Headers whose values come from environment variables (header name to\nvariable name), so a secret is never written in configuration.",
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "prime-agent's `headers`, for a Streamable HTTP server: static values\nthat are not secrets. A secret header is named in `header_env`.",
          "type": "object"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "startup_timeout_seconds": {
          "default": null,
          "description": "prime-agent's `startupTimeoutMs`, in seconds: how long the server may\ntake to start and answer the handshake.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_timeout_seconds": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "transport": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ModelConfigV2": {
      "additionalProperties": false,
      "properties": {
        "context_window": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_price_per_mtok": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "output_price_per_mtok": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "supports_images": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PermissionsConfigV2": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProfileConfigV2": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/LimitsConfigV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderConfigV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "ProviderConfigV2": {
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "default": null,
          "pattern": "^plan_item_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "QueueConfigV2": {
      "additionalProperties": false,
      "properties": {
        "follow_up_mode": {
          "default": null,
          "description": "`all` or `one-at-a-time` (the default).",
          "type": [
            "string",
            "null"
          ]
        },
        "steering_mode": {
          "default": null,
          "description": "`all` or `one-at-a-time` (the default).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RoutingConfigV2": {
      "additionalProperties": false,
      "properties": {
        "auxiliary": {
          "default": null,
          "description": "The model that writes compaction summaries and `/refine` reviews.",
          "type": [
            "string",
            "null"
          ]
        },
        "backup": {
          "default": null,
          "description": "The model a turn moves to when the session model keeps failing.",
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "default": null,
          "description": "The model a request with images goes to when the session model takes text only.",
          "type": [
            "string",
            "null"
          ]
        },
        "scoped": {
          "default": null,
          "description": "Patterns over `provider/id` or `id` (`*` and `?`, any case, optional\n`:level`) naming the models `/model next` and Alt+M cycle through.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "wait_for_usage": {
          "default": null,
          "description": "Wait for a rate-limited provider to recover instead of failing (default true).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TrustConfigV2": {
      "additionalProperties": false,
      "properties": {
        "projects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "UiConfigV2": {
      "additionalProperties": false,
      "properties": {
        "bell": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "color": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "notify_command": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "renderer": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://harness-agents.local/schemas/harness-config.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Additive user configuration contract for the interactive agent.\n\nThe v1 [`HarnessConfig`] remains frozen for P0 consumers and keeps generating\n`harness-config.v1.schema.json`; this v2 contract is emitted separately.",
  "properties": {
    "agents": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentsConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Delegated children: prime-agent's `subagentDefaultModel`."
    },
    "cli": {
      "$ref": "#/$defs/CliPresentationConfig",
      "default": {
        "output": "text"
      }
    },
    "hooks": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/HookConfigV2"
        },
        "type": "array"
      },
      "default": {},
      "type": "object"
    },
    "limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/LimitsConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mcp_servers": {
      "additionalProperties": {
        "$ref": "#/$defs/McpServerConfigV2"
      },
      "default": {},
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelConfigV2"
      },
      "default": {},
      "type": "object"
    },
    "permissions": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionsConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ProfileConfigV2"
      },
      "default": {},
      "type": "object"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "queue": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueueConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Messages queued while the agent works: prime-agent's `steeringMode` and\n`followUpMode`."
    },
    "routing": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoutingConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Which models the session cycles through and which it hands work to:\nprime-agent's `enabledModels`, `auxiliaryModel`, `backupModel` and\n`imageModel`."
    },
    "schema_version": {
      "const": 2,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "trust": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrustConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiConfigV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "HarnessConfigV2",
  "type": "object",
  "x-harness-schema-version": 2
}
