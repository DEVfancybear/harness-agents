{
  "$defs": {
    "ErrorCode": {
      "description": "Stable machine-readable error categories used by P0 contracts and the CLI.",
      "oneOf": [
        {
          "enum": [
            "invalid_hash",
            "invalid_id",
            "invalid_payload",
            "invalid_sequence",
            "missing_authority",
            "unsupported_schema_version",
            "config_read_error",
            "config_parse_error",
            "config_unknown_field",
            "fixture_integrity",
            "gate_configuration_error",
            "gate_required_test_ignored",
            "gate_test_discovery_empty",
            "writer_locked",
            "stale_writer",
            "read_only_store",
            "sequence_conflict",
            "idempotency_conflict",
            "task_lease_conflict",
            "storage_open_failed",
            "storage_write_failed",
            "migration_failed",
            "snapshot_corrupt",
            "unknown_critical_event",
            "artifact_write_failed",
            "missing_required_service",
            "incompatible_service",
            "plugin_cycle",
            "duplicate_registration",
            "service_unavailable",
            "shutdown_failed",
            "invalid_state_transition",
            "mandatory_context_overflow",
            "provider_canceled",
            "provider_protocol",
            "retry_exhausted",
            "compaction_conflict",
            "runtime_command_conflict",
            "runtime_blocked",
            "policy_denied",
            "approval_required",
            "approval_stale",
            "approval_consumed",
            "approval_revoked",
            "workspace_escape",
            "sensitive_path_denied",
            "stale_workspace",
            "unsupported_text_encoding",
            "binary_content_denied",
            "output_limit_exceeded",
            "process_timed_out",
            "process_canceled",
            "process_outcome_unknown",
            "strict_isolation_unavailable",
            "project_identity_conflict",
            "tool_intent_conflict",
            "edit_not_found",
            "edit_ambiguous",
            "task_not_found",
            "task_not_ready",
            "task_dependency_failed",
            "task_ownership_conflict",
            "dag_cycle",
            "unknown_task_dependency",
            "duplicate_task_id",
            "ambiguous_task_owner",
            "delegation_depth_exceeded",
            "budget_exhausted",
            "scope_authority_denied",
            "dirty_workspace_denied",
            "integration_conflict",
            "result_incomplete",
            "scheduler_shutdown",
            "delivery_conflict",
            "extension_protocol_error",
            "extension_digest_mismatch",
            "extension_protocol_unsupported",
            "extension_not_found",
            "extension_untrusted",
            "extension_capability_mismatch",
            "host_method_denied",
            "environment_denied",
            "secret_not_granted",
            "frame_limit_exceeded",
            "inflight_limit_exceeded",
            "duplicate_frame_id",
            "schema_version_mismatch",
            "skill_unavailable",
            "config_trust_required",
            "backup_manifest_invalid",
            "restore_target_conflict",
            "retention_refused"
          ],
          "type": "string"
        },
        {
          "const": "delegation_queue_full",
          "description": "A delegation was refused because the queue already holds as many workers\nas it may. Distinct from `BudgetExhausted`, which says no more requests may\nbe spent: a full queue is backpressure and clears when a worker settles,\nwhere an exhausted budget does not clear at all.",
          "type": "string"
        },
        {
          "const": "source_unavailable",
          "description": "A referenced durable source is no longer available to read. Distinct\nfrom a scope refusal: the caller may read it in principle, but the bytes\nbehind the reference are gone.",
          "type": "string"
        }
      ]
    },
    "RetryClass": {
      "description": "How a caller may retry after a failure. The class is derived from the\nstable code, never from the human-readable message.",
      "oneOf": [
        {
          "const": "never",
          "description": "The same input cannot succeed by repeating it.",
          "type": "string"
        },
        {
          "const": "transient",
          "description": "The operation may be repeated; the failure was environmental.",
          "type": "string"
        },
        {
          "const": "bounded",
          "description": "The operation may be repeated inside a bounded retry budget.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "State moved; re-read and rebase before trying again.",
          "type": "string"
        },
        {
          "const": "human_action",
          "description": "Progress needs a human decision, answer, or grant.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://harness-agents.local/schemas/error-report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The serializable error contract. Display messages are diagnostics; only the\ncode, retry class and envelope version are protocol.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "correlation_id": {
      "pattern": "^event_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": [
        "string",
        "null"
      ]
    },
    "details_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_class": {
      "$ref": "#/$defs/RetryClass"
    },
    "safe_message": {
      "description": "A message that is safe to show and to log: it never carries credentials,\nbearer tokens, or raw endpoint queries.",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "code",
    "retry_class",
    "safe_message"
  ],
  "title": "ErrorReport",
  "type": "object",
  "x-harness-schema-version": 1
}
